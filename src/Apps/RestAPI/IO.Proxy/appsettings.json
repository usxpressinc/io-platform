{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "IO.Core.Authentication": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:8080"
      }
    }
  },
  "APPLICATION": {
    "PROJECT": "io-platform",
    "GROUP": "gateway",
    "ENVIRONMENT": "development"
  },
  "TOKEN_FACTORY": {
    "SECRET": "#{TOKEN_FACTORY__SECRET}",
    "MASTER_TOKEN": "#{TOKEN_FACTORY__MASTER_TOKEN}",
    "DEFAULT_LIFETIME_HOURS": "#{TOKEN_FACTORY__DEFAULT_LIFETIME_HOURS}"
  },
  "SERVICE_ACCOUNT_USER": "#{SERVICE_ACCOUNT_USER}",
  "SERVICE_ACCOUNT_PASSWORD": "#{SERVICE_ACCOUNT_PASSWORD}",
  "Services": {
    "Common": {
      "BaseUrl": "api.common#{_env}.usxpress.io"
    },
    "Cass": {
      "BaseUrl": "api.cass#{_env}.usxpress.io"
    },
    "Elsa": {
      "BaseUrl": "api.elsa#{_env}.usxpress.io"
    }
  },
  "ServiceRoutes": {
    "Routes": {
      "/api/common": {
        "ServiceName": "IO.Common",
        "HttpClientName": "io-common",
        "PathPrefix": "/api/common",
        "BaseUrl": "api.common#{_env}.usxpress.io",
        "AuthType": "None",
        "OAuthClientId": "#{ServiceRoutes__Common__OAuthClientId}",
        "OAuthResource": "#{ServiceRoutes__Common__OAuthResource}",
        "OAuthTenantId": "#{ServiceRoutes__Common__OAuthTenantId}",
        "OAuthClientSecret": "#{ServiceRoutes__Common__OAuthClientSecret}"
      },
      "/api/clara": {
        "ServiceName": "IO.Clara",
        "HttpClientName": "io-cass",
        "PathPrefix": "/api/clara",
        "BaseUrl": "api.cass#{_env}.usxpress.io",
        "AuthType": "None",
        "OAuthClientId": "#{ServiceRoutes__Clara__OAuthClientId}",
        "OAuthResource": "#{ServiceRoutes__Clara__OAuthResource}",
        "OAuthTenantId": "#{ServiceRoutes__Clara__OAuthTenantId}",
        "OAuthClientSecret": "#{ServiceRoutes__Clara__OAuthClientSecret}"
      },
      "/api/elsa": {
        "ServiceName": "IO.Elsa",
        "HttpClientName": "io-elsa",
        "PathPrefix": "/api/elsa",
        "BaseUrl": "api.elsa#{_env}.usxpress.io",
        "AuthType": "None",
        "OAuthClientId": "#{ServiceRoutes__Elsa__OAuthClientId}",
        "OAuthResource": "#{ServiceRoutes__Elsa__OAuthResource}",
        "OAuthTenantId": "#{ServiceRoutes__Elsa__OAuthTenantId}",
        "OAuthClientSecret": "#{ServiceRoutes__Elsa__OAuthClientSecret}"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
